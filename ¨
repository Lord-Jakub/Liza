func GetType(t string) C.ffi_type {
	switch t {
	case "int":
		return C.ffi_type_sint
	case "string":
		return C.ffi_type_pointer
	case "void":
		return C.ffi_type_void
	case "float":
		return C.ffi_type_float
	}
	return C.ffi_type{}
}
